# ═══════════════════════════════════════════════════════════════
# E-MARKET .gitignore — PROJET ACADÉMIQUE
# Rien de sensible (mdp, tokens, .env) ne doit aller sur GitHub !
# ═══════════════════════════════════════════════════════════════

# ── DEPENDANCES NODE ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ── FICHIERS DE CONFIG SENSIBLES ─────────────────────────────
backend/.env
backend/.env.*
!.env.example        # on garde LE MODELE .env.example
.env
.env.local
.env.*.local
.env.production
.env.development

# ── CLES SSH / CERTIFICATS SSL ──────────────────────────────
*.pem
*.ppk               # clés PuTTYgen
*.key
*.crt
*.p12
*.pfx
*.cer

# ── BASES DE DONNÉES / BACKUPS ──────────────────────────────
*.sql
!database/01_schema.sql        # schéma OK sur GitHub
!database/02_seed_data.sql     # données d'exemple OK
*.sql.backup
*.sql.gz
*.dump
backup*/

# ── LOGS / TEMP ─────────────────────────────────────────────
*.log
logs/
temp/
tmp/
uploads/
.cache/
.DS_Store
Thumbs.db

# ── IDE / ÉDITEURS ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── FICHIERS WINDOWS TEMP ───────────────────────────────────
*.bat.debug
*.sh~
desktop.ini

# ── PM2 PROCESS FILE ────────────────────────────────────────
ecosystem.config.js
dump.pm2
